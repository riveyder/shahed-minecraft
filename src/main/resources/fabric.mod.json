{
  "schemaVersion": 1,
  "id": "shahed",
  "version": "${version}",
  "name": "SHAHED.exe — FPV Mayhem",
  "description": "ТОВ «КРИВІ РУКИ AEROSPACE». Server-authoritative arcade drone flight, UUID-linked controllers, full-screen FPV camera and telemetry.",
  "authors": ["riveyder"],
  "contact": {"sources": "https://github.com/riveyder/shahed-minecraft"},
  "license": "MIT",
  "icon": "assets/shahed/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.riveyder.shahed.ShahedMod"],
    "client": ["io.github.riveyder.shahed.client.ShahedClient"]
  },
  "mixins": [
    "shahed.mixins.json",
    {"config": "shahed.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2"
  }
}
